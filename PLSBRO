<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Be My Friend Again 💕</title>

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      min-height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      font-family: "Comic Sans MS", cursive, sans-serif;
      background: linear-gradient(135deg, #ffd6e7, #d9c2ff, #bdefff);
      overflow: hidden;
    }

    .card {
      position: relative;
      text-align: center;
      padding: 55px 40px;
      width: 90%;
      max-width: 650px;
      background: rgba(255, 255, 255, 0.85);
      border: 5px solid #ff8fbd;
      border-radius: 35px;
      box-shadow: 0 15px 40px rgba(150, 80, 150, 0.3);
      animation: float 3s ease-in-out infinite;
    }

    h1 {
      color: #ff4f9a;
      font-size: clamp(2.5rem, 8vw, 5rem);
      margin: 10px 0;
      text-shadow: 3px 3px #ffd0e4;
    }

    p {
      color: #8b4b83;
      font-size: 1.4rem;
    }

    button {
      margin-top: 20px;
      padding: 16px 30px;
      border: none;
      border-radius: 50px;
      background: #ff69a9;
      color: white;
      font-size: 1.2rem;
      font-family: inherit;
      cursor: pointer;
      box-shadow: 0 7px 0 #d83f83;
      transition: 0.2s;
    }

    button:hover {
      transform: translateY(-3px) scale(1.05);
      background: #ff4f9a;
    }

    button:active {
      transform: translateY(4px);
      box-shadow: 0 3px 0 #d83f83;
    }

    .heart {
      position: absolute;
      font-size: 2rem;
      animation: spin 4s linear infinite;
    }

    .h1 { top: 15px; left: 25px; }
    .h2 { top: 20px; right: 30px; }
    .h3 { bottom: 20px; left: 35px; }
    .h4 { bottom: 15px; right: 35px; }

    .sparkle {
      position: fixed;
      color: white;
      font-size: 25px;
      animation: sparkle 3s infinite;
    }

    @keyframes float {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(-10px); }
    }

    @keyframes spin {
      0% { transform: rotate(0deg) scale(1); }
      50% { transform: rotate(15deg) scale(1.2); }
      100% { transform: rotate(0deg) scale(1); }
    }

    @keyframes sparkle {
      0% { opacity: 0; transform: translateY(20px); }
      50% { opacity: 1; }
      100% { opacity: 0; transform: translateY(-100px); }
    }
  </style>
</head>

<body>

  <div class="sparkle" style="left:10%; top:80%;">✦</div>
  <div class="sparkle" style="left:80%; top:70%; animation-delay:1s;">✧</div>
  <div class="sparkle" style="left:25%; top:20%; animation-delay:2s;">✨</div>
  <div class="sparkle" style="left:90%; top:30%; animation-delay:.5s;">✦</div>

  <div class="card">
    <div class="heart h1">💗</div>
    <div class="heart h2">💖</div>
    <div class="heart h3">💕</div>
    <div class="heart h4">💞</div>

    <div style="font-size: 4rem;">🥺👉👈</div>

    <h1>Be My Friend Again Pls!</h1>

    <p>Can we be friends again? 🥹💗</p>

    <button onclick="speakMessage()">
      🔊 Say It Out Loud
    </button>
  </div>

  <script>
    function speakMessage() {
      const message = new SpeechSynthesisUtterance(
        "Be my friend again, please!"
      );

      message.rate = 0.9;
      message.pitch = 1.3;
      message.volume = 1;

      speechSynthesis.cancel();
      speechSynthesis.speak(message);
    }
  </script>

</body>
</html>
